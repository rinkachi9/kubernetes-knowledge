  "concepts": [
    {
      "term": "Liveness probe",
      "anchor": "#liveness-probe",
      "definition": "A check whose repeated failure makes the kubelet restart the container."
    },
    {
      "term": "Readiness probe",
      "anchor": "#readiness-probe",
      "definition": "A check whose failure removes the Pod from Service endpoints without a restart."
    },
    {
      "term": "Startup probe",
      "anchor": "#startup-probe",
      "definition": "A check that holds back liveness and readiness probes until the application has started."
    }
