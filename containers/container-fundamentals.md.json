    {
      "term": "Container",
      "anchor": "#what-a-container-is",
      "definition": "An isolated process on a shared kernel, created from an immutable image, with namespaces and cgroups applied."
    },
    {
      "term": "Immutability",
      "anchor": "#container-images",
      "definition": "The rule that running containers are never changed; a change means a new image and a new container."
